# URL de l’API Fastify (uberEats-api)
NUXT_PUBLIC_API_BASE=http://localhost:3001

# Côté uberEats-api : définir CORS_ORIGIN sur l’URL du front Nuxt
# (ex. http://localhost:3000) pour autoriser les requêtes navigateur.
DATABASE_URL="mysql://root:root@127.0.0.1:3306/ubereats_api"
JWT_SECRET="tkt_c_grave_secur"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
CORS_CREDENTIALS="true"

LOGIN_MAX_ATTEMPTS_PER_WINDOW=5
LOGIN_WINDOW_MS=60000
LOGIN_BAN_MS=900000
LOGIN_SOFT_LOCK_BASE_MS=1000
LOGIN_SOFT_LOCK_MAX_MS=30000